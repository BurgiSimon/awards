[
 {
  "name": "menu-open",
  "actions": [
   {
    "type": "click",
    "selector": ".bridge__menu"
   },
   {
    "type": "waitFor",
    "selector": "#chapters:not([hidden])"
   }
  ]
 },
 {
  "name": "menu-escape",
  "actions": [
   {
    "type": "click",
    "selector": ".bridge__menu"
   },
   {
    "type": "waitFor",
    "selector": "#chapters:not([hidden])"
   },
   {
    "type": "press",
    "key": "Escape"
   },
   {
    "type": "waitFor",
    "selector": "#chapters",
    "state": "hidden"
   }
  ]
 },
 {
  "name": "menu-kbd-back",
  "actions": [
   {
    "type": "click",
    "selector": ".bridge__menu"
   },
   {
    "type": "waitFor",
    "selector": "#chapters:not([hidden])"
   },
   {
    "type": "press",
    "key": "Shift+Tab"
   }
  ]
 },
 {
  "name": "menu-pick",
  "actions": [
   {
    "type": "click",
    "selector": ".bridge__menu"
   },
   {
    "type": "click",
    "selector": "#chapters a[href=\"#drag\"]"
   },
   {
    "type": "wait",
    "ms": 900
   }
  ]
 }
]